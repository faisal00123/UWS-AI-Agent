# Dependencies
node_modules/

# Secrets - never commit real credentials
.env
.env.local
*.pem
*.key

# Runtime data (SQLite database, uploads, backups)
data/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Logs
logs/
*.log
npm-debug.log*

# Editor / OS
.vscode/settings.json
.idea/
Thumbs.db
Desktop.ini

# Test artifacts
coverage/
.tmp/

# Offline OSM datasets — raw Geofabrik PBF and derived lead datasets are
# never committed to the public repo (ODbL data stays on the owner's machine)
*.pbf
*.ndjson
*.ndjson.tmp
*.ndjson.meta.json
