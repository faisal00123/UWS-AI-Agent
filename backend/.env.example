# ---------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=3100
PUBLIC_BASE_URL=http://localhost:3100
DATABASE_PATH=./data/uws.sqlite

# Session secret: generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production; a random ephemeral secret is used in development.
SESSION_SECRET=

# 'simulation' (default, safe) or 'live' (requires explicit owner action to
# place any real call/message). Keep 'simulation' until Phase 11B approval.
OPERATING_MODE=simulation

BUSINESS_TIMEZONE=Asia/Karachi
BUSINESS_NAME=Universal Web Solutions
BUSINESS_WEBSITE=https://www.universalwebsolutions.it.com

# ---------------------------------------------------------------------
# Telephony (Task 1) — e.g. Twilio
# ---------------------------------------------------------------------
# TELEPHONY_PROVIDER: 'twilio' | 'cloudyvoice' | 'mock' | '' (unconfigured)
TELEPHONY_PROVIDER=
TELEPHONY_ACCOUNT_SID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_FROM_NUMBER=

# ---------------------------------------------------------------------
# SIP gateway bridge — CloudyVoice (intended primary outbound provider)
# ---------------------------------------------------------------------
# CloudyVoice is a SIP *termination carrier* (no HTTP call-placement API):
# calls leave through OUR gateway process (Asterisk/FreeSWITCH on the VPS,
# see deploy/sip/). This block configures the BACKEND <-> GATEWAY link only.
# The carrier values (SIP host, port, transport, auth, codecs, CLI) live
# ONLY in the gateway's own config on the VPS — never in this file.
#
# To select this provider set BOTH:
#   TELEPHONY_PROVIDER=cloudyvoice
#   TELEPHONY_FROM_NUMBER=            (caller ID — must be CLI-approved by
#                                      CloudyVoice before any live dial)
#
# Absolute http(s) base URL of the gateway control API
# (e.g. http://127.0.0.1:8089 when the gateway runs on the same host).
SIP_GATEWAY_BASE_URL=
# Bearer token this backend presents to the gateway (outbound control).
# Generate one yourself, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIP_GATEWAY_API_TOKEN=
# HMAC-SHA256 secret the gateway uses to sign lifecycle events it posts back.
# (Different token from the above; same generation method.)
SIP_GATEWAY_EVENT_SECRET=
# Per-request timeout for gateway control calls in ms (500-60000, default 10000).
SIP_GATEWAY_TIMEOUT_MS=

# NOTE: selecting cloudyvoice does NOT make calling live. Live mode still
# requires OPERATING_MODE=live + outreach resumed + a VERIFIED CloudyVoice
# onboarding (free SIP registration check + an owner-approved test call).

# ---------------------------------------------------------------------
# WhatsApp Business (Task 4) — Meta Cloud API
# ---------------------------------------------------------------------
# WHATSAPP_PROVIDER: 'meta_cloud' | 'mock' | '' (unconfigured)
WHATSAPP_PROVIDER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Name of the APPROVED portfolio template (Meta requires pre-approval).
WHATSAPP_TEMPLATE_NAME_PORTFOLIO=
# BCP-47 language code of the approved template (e.g. 'en', 'ur').
WHATSAPP_TEMPLATE_LANGUAGE=en
# Meta app secret — verifies X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_APP_SECRET=
# Owner-chosen token Meta must echo on the webhook subscription GET.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---------------------------------------------------------------------
# AI conversation engine (Task 2) — multiple providers supported
# ---------------------------------------------------------------------
# AI_PROVIDER: 'openai' | 'anthropic' | 'gemini' | 'mock' | '' (unconfigured)
AI_PROVIDER=
AI_API_KEY=
# Model id, e.g. 'gpt-4o-mini', 'claude-3-5-sonnet-latest', 'gemini-1.5-flash'.
AI_MODEL=
# Optional: point an OpenAI-compatible provider at a self-hosted base URL.
AI_BASE_URL=

# ---------------------------------------------------------------------
# Speech: STT + TTS (OpenAI /audio/transcriptions + /audio/speech)
# ---------------------------------------------------------------------
# STT_PROVIDER / TTS_PROVIDER: 'openai' | 'mock' | '' (unconfigured)
STT_PROVIDER=
# Dedicated speech keys are OPTIONAL: when STT_API_KEY / TTS_API_KEY are
# empty, the adapter authenticates with AI_API_KEY (same vendor, same host —
# the OpenAI platform key already used for the conversation model). If a
# dedicated key is a foreign-format one the provider rejects (401), the
# adapter fails over to AI_API_KEY once and reports which path it used.
STT_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=
# Model ids (both verified present on the configured key). Empty = defaults.
STT_MODEL=whisper-1
TTS_MODEL=tts-1
# Default language the audio is spoken in: 'en' or 'ur'.
# Roman Urdu: no STT provider accepts a roman_ur code — the audio IS Urdu,
# so STT runs with 'ur' and the Roman-Urdu TEXT is handled by the AI layer.
# Mixed/unknown conversations send NO hint (provider auto-detects).
SPEECH_LANGUAGE=en
# Default TTS voice (English / fallback). Urdu voice falls back to this.
SPEECH_VOICE=
SPEECH_VOICE_UR=

# ---------------------------------------------------------------------
# Email / SMTP (Task 5) — owner notifications + daily reports
# ---------------------------------------------------------------------
# EMAIL_PROVIDER: 'smtp' | 'mock' | '' (unconfigured; defaults to smtp when set)
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Where owner alerts are delivered (may equal OWNER_EMAIL).
NOTIFY_OWNER_EMAIL=

# ---------------------------------------------------------------------
# Lead discovery (Task 6; Phase 12)
# ---------------------------------------------------------------------
# DISCOVERY_PROVIDER: 'mock' | 'overpass' | '' (unconfigured)
# Phase 12 wired a REAL vendor: OpenStreetMap via the free Overpass API.
# 'overpass' needs NO API key (public data) — set the provider and restart.
# Coverage: Pakistan only (OSM area scope); good for named businesses with a
# published phone, thinner than commercial directories. 'mock' remains for
# rehearsal; anything else (or empty) stays honestly unconfigured and leads
# continue through the CSV/Excel import path.
DISCOVERY_PROVIDER=
# Only needed for keyed vendors (unused by 'overpass'):
DISCOVERY_API_KEY=
# Optional: self-hosted Overpass instance (empty = the public
# https://overpass-api.de instance):
DISCOVERY_OVERPASS_URL=

# ---------------------------------------------------------------------
# Duplex live-call bridge (live two-way voice on answered calls)
# ---------------------------------------------------------------------
# The answer TwiML speaks the mandated AI disclosure, then opens a Twilio
# Media Stream into /api/media (signed, expiring token; WSS). The engine
# runs over real audio: VAD -> STT -> AI turn -> TTS -> paced mu-law frames.
# Requires BOTH STT and AI configured; otherwise the fixed greeting + hangup
# is served and the upgrade returns 503 (never a silent call).
# The bridge NEVER dials and NEVER records (<Record/> is never emitted).
DUPLEX_ENABLED=true
# RMS above which an inbound frame counts as speech (mu-law PCM scale).
DUPLEX_VAD_THRESHOLD=400
# Trailing silence that ends a prospect utterance (ms).
DUPLEX_SILENCE_MS=600
# Hard cap on a single utterance (ms; bounds memory per call).
DUPLEX_MAX_UTTERANCE_MS=15000
# Hard cap on one live call's duration (seconds; then the bridge hangs up).
DUPLEX_MAX_CALL_SECONDS=300

# ---------------------------------------------------------------------
# Adapter resilience (Task 8)
# ---------------------------------------------------------------------
# Total attempts (including the first) for IDEMPOTENT operations only
# (AI completions, transcription, synthesis, discovery search, health
# probes). Paid non-idempotent actions (createCall, sendTemplate) are
# NEVER auto-retried — a retry could double-charge or double-contact.
ADAPTER_RETRY_ATTEMPTS=2
# Per-integration operations-per-minute rate limit (applies to every op).
ADAPTER_RATE_LIMIT_PER_MIN=60

# ---------------------------------------------------------------------
# Bootstrap owner (optional; created on first run if the users table is empty)
# ---------------------------------------------------------------------
OWNER_EMAIL=
OWNER_PASSWORD=

# ---------------------------------------------------------------------
# Backups (encrypted archives of ./data/uws.sqlite)
# ---------------------------------------------------------------------
# Opt-in scheduled backups (doctor shows the state either way).
BACKUP_ENABLED=false
BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_HOURS=24
# Encrypts backup archives (recommended). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Empty = backups stored unencrypted (doctor warns).
BACKUP_PASSPHRASE=

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
LOG_LEVEL=info
LOG_REDACT=true
