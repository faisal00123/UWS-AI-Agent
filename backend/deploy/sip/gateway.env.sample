# =====================================================================
#  SIP gateway bridge — environment template (deploy ON THE VPS ONLY)
#
#  Copy to `.env` next to the gateway bridge process and fill in.
#  Every value below is a PLACEHOLDER — no real credentials included.
#  NEVER commit a filled-in copy (add it to .gitignore on the VPS).
#
#  This file configures OUR gateway process. Carrier values (SIP host,
#  port, transport, auth) live in the engine config (pjsip.conf etc.),
#  not here — except GW_CARRIER_* placeholders which the bridge reads
#  ONLY if your engine integration needs them; prefer engine config.
# =====================================================================

# ------------------- backend link (must match backend/.env) -----------
# Bearer token the BACKEND presents to this gateway (control API).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GW_API_TOKEN=

# HMAC-SHA256 secret this gateway uses when signing event POSTs to the
# backend (header: X-UWS-Gateway-Signature). Generate separately.
GW_EVENT_SECRET=

# Backend public base URL (answer fetch, signed events, media WebSocket).
GW_BACKEND_BASE_URL=https://REPLACE_WITH_PUBLIC_HOST

# ------------------- control API --------------------------------------
# Loopback when the backend runs on this same host. NEVER bind this to a
# public interface without also restricting it to the backend's IP.
GW_CONTROL_HOST=127.0.0.1
GW_CONTROL_PORT=8089

# ------------------- media --------------------------------------------
# RTP port range for the engine (must match rtp.conf.sample and the
# firewall rule; confirm the allowed range with the carrier).
GW_RTP_START=10000
GW_RTP_END=10127

# Media format we bridge to the backend: ONLY G.711 mu-law 8 kHz mono.
# The backend refuses any other encoding — transcode here or don't bridge.
GW_MEDIA_ENCODING=audio/x-mulaw
GW_MEDIA_SAMPLE_RATE=8000

# ------------------- engine integration -------------------------------
# 'asterisk' or 'freeswitch' — decided by the Phase-1 spike.
GW_ENGINE=

# Engine AMI/ESL endpoint used by the bridge to originate/hang up and to
# observe call state (loopback by default).
GW_ENGINE_HOST=127.0.0.1
# GW_ENGINE_PORT=5038            # Asterisk AMI default (uncomment if used)
# GW_ENGINE_SECRET=              # AMI/ESL manager secret (REPLACE_WITH_…)

# ------------------- carrier placeholders -----------------------------
# Filled ONLY from CloudyVoice onboarding paperwork — never invented.
# They belong to the engine config in most setups; kept here so a bridge
# implementation that reads them has a defined home.
GW_CARRIER_PROXY_HOST=REPLACE_WITH_CARRIER_SIP_HOST
GW_CARRIER_PROXY_PORT=REPLACE_WITH_CARRIER_SIP_PORT
GW_CARRIER_TRANSPORT=REPLACE_WITH_udp_tcp_tls
GW_CARRIER_USERNAME=REPLACE_WITH_SIP_USERNAME
GW_CARRIER_PASSWORD=REPLACE_WITH_SIP_PASSWORD
GW_CARRIER_CALLER_ID=REPLACE_WITH_CLI_APPROVED_E164

# ------------------- operating safety ---------------------------------
# The bridge refuses to originate anything unless explicitly unlocked for
# an owner-approved TEST call. Live outreach is gated in the BACKEND
# (OPERATING_MODE + outreach pause) — this is defence in depth only.
GW_ALLOW_ORIGINATE=false
